rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins can manage moderation, spam queue, and appeals
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nochafpeace@gmail.com' ||
        request.auth.token.email == 'nochafpeacesecret@gmail.com'
      );
    }

    // Global Unique Username Registry
    match /usernames/{username} {
      allow read: if true;
      allow write: if true;
    }

    // Per-device Signup Limits (Layer 1 & 3)
    match /deviceLimits/{deviceId} {
      allow read, write: if true;
    }

    // Private Google Account linkage (Layer 2)
    match /usersPrivate/{userId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isOwner(userId);

      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId) || true;
        match /messages/{messageId} {
          allow read, write: if isOwner(userId) || true;
        }
      }

      match /projects/{projectId} {
        allow read, write: if isOwner(userId) || true;
      }

      match /memories/{memoryId} {
        allow read, write: if isOwner(userId) || true;
      }

      match /generatedImages/{imageId} {
        allow read, write: if isOwner(userId) || true;
      }
    }

    // Direct Messages (Nochaf Chat)
    match /directMessages/{dmId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Group Discussions
    match /groupDiscussions/{groupId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Spam Queue for Review (Layer 6)
    match /spamQueue/{queueId} {
      allow read, write: if true;
    }

    // Appeals Queue ("I'm not spam")
    match /appeals/{appealId} {
      allow read, write: if true;
    }

    // Moderation Reports
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Test connection & health checks
    match /test/{testId} {
      allow read, write: if true;
    }

    // Catch-all to prevent any missing permission errors on dynamic collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
